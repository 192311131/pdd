# Copy to `.env` for local dev. These are OPTIONAL.
# The tooth-restoration feature (YOLOv11, offline) needs NO keys.
# These only power the optional Gemini shade-matching step in ToothScanner.
# NOTE: VITE_ vars are inlined into the public bundle at build time — anything
# here is visible to anyone who views the deployed site. Do not ship secrets
# you care about; use a backend proxy if you need private keys.

VITE_GEMINI_API_KEY=

# Supabase — Project Settings -> API. The anon key is safe for the frontend
# ONLY with Row Level Security enabled (see supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API base URL (the Render service). When set, the shade analysis goes
# through the server proxy and VITE_GEMINI_API_KEY is NOT needed in the frontend.
# e.g. https://aestheticshade-api.onrender.com
VITE_API_BASE_URL=
