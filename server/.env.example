# Backend secrets — set these in Render (Environment), NOT in the frontend.
# Copy to `server/.env` for local dev.

# Google Gemini key (kept server-side; never shipped to the browser).
GEMINI_API_KEY=

# Comma-separated frontend origins allowed to call this API.
# e.g. https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
